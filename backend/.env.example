# Copy to .env for local work. On Render, set these as environment variables instead.
# Neon: Dashboard > Connection Details > copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
API_KEY=choose-a-long-random-string
SECRET_KEY=another-long-random-string
DEBUG=false
ALLOWED_HOSTS=your-app.onrender.com
